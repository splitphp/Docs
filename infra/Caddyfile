{
	order rate_limit before reverse_proxy
}

mcp.splitphp.org {
	rate_limit {
		zone mcp { key {remote_host}; events 60; window 1m }   # protect the public endpoint
	}
	reverse_proxy localhost:3001 {
		header_up Authorization "Bearer {$MCP_KEY}"    # inject the internal key; the public sends no token
		flush_interval -1                              # MCP uses SSE/streaming
	}
}
